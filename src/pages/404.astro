<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Page not found · Coinio</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <style>
    :root { color-scheme: light dark; --bg: #f8f8fb; --text: #16172b; --muted: #55576e; --brand: #4f5bd5; }
    @media (prefers-color-scheme: dark) { :root { --bg: #0b0c14; --text: #ecedf7; --muted: #a3a5bd; --brand: #8e96ff; } }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--text);
      font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; padding: 0 16px; text-align: center; }
    h1 { font-size: 32px; margin: 0 0 8px; letter-spacing: -0.02em; }
    p { margin: 0 0 24px; color: var(--muted); }
    a { color: var(--brand); font-weight: 600; text-underline-offset: 3px; }
  </style>
</head>
<body>
  <main>
    <h1>Page not found</h1>
    <p>This address doesn't exist on getcoinio.me.</p>
    <a href="/">Go to the Coinio home page</a>
  </main>
</body>
</html>
