---
import { LANGS, pagePath, REPO, type LangDef, type PageSlug } from '../lib/i18n';
import Wordmark from './Wordmark.astro';

interface Props {
  lang: LangDef;
  slug: PageSlug;
  t: Record<string, string>;
}

const { lang, slug, t } = Astro.props;
const isHome = slug === '';
const home = isHome ? '' : lang.path;
const brandHref = isHome ? '#top' : lang.path;
const shortCode = lang.code.split('-')[0].toUpperCase();
---
<header class="nav">
  <div class="nav-inner">
    <div class="nav-left">
      <a class="brand" href={brandHref} aria-label={t['nav.home']}>
        <Wordmark />
      </a>
    </div>

    <nav class="nav-center" aria-label={t['nav.main']}>
      <a class="nav-link" href={`${home}#demo`}>{t['nav.demo']}</a>
      <a class="nav-link" href="https://docs.getcoinio.me">{t['nav.docs']}</a>
      <a class="nav-link" href={`${home}#faq`}>{t['nav.faq']}</a>
    </nav>

    <div class="nav-right">
      <a class="nav-icon" href={REPO} aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>

      <details class="lang">
        <summary aria-label={`${shortCode}, ${t['lang.label']}: ${lang.name}`} title={t['lang.label']}>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="8" cy="8" r="6.25"/>
            <path d="M1.75 8h12.5M8 1.75c1.8 1.9 2.6 3.9 2.6 6.25S9.8 12.35 8 14.25C6.2 12.35 5.4 10.35 5.4 8S6.2 3.65 8 1.75z"/>
          </svg>
          <span>{shortCode}</span>
        </summary>
        <ul class="lang-menu">
          {LANGS.map((l) => (
            <li>
              <a
                href={pagePath(l, slug)}
                hreflang={l.code}
                lang={l.code}
                aria-current={l.code === lang.code ? 'page' : undefined}
              >
                {l.name}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <button class="theme-btn" type="button" aria-label={t['theme.toLight']} title={t['theme.title']}>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
        </svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/>
        </svg>
      </button>

      <span class="nav-sep" aria-hidden="true"></span>

      <a class="nav-cta" href="https://app.getcoinio.me/signup">{t['nav.startFree']}</a>
    </div>
  </div>
</header>
