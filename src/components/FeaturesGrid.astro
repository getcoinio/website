---
import type { LangDef } from '../lib/i18n';

interface Props {
  lang: LangDef;
  t: Record<string, string>;
}

const { lang, t } = Astro.props;
---
<section class="section" aria-labelledby="features-title">
  <div class="section-head">
    <p class="eyebrow">{t['features.eyebrow']}</p>
    <h2 id="features-title"><Fragment set:html={t['features.title']} /></h2>
  </div>
  <div class="features">
    <article class="feature">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/><circle cx="15.5" cy="14.5" r="1.6" class="fill"/></svg>
      <h3>{t['features.remindersTitle']}</h3>
      <p>{t['features.remindersBody']}</p>
    </article>
    <article class="feature">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="12" r="5.5"/><path d="M14.2 6.8a5.5 5.5 0 1 1 0 10.4"/><path d="M9 9.5v5"/></svg>
      <h3>{t['features.currencyTitle']}</h3>
      <p>{t['features.currencyBody']}</p>
    </article>
    <article class="feature">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10M14 4l3 3-3 3M17 17H7M10 14l-3 3 3 3"/></svg>
      <h3>{t['features.fireflyTitle']}</h3>
      <p><Fragment set:html={t['features.fireflyBody']} /></p>
    </article>
    <article class="feature">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="3.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="3.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="2"/></svg>
      <h3>{t['features.catalogTitle']}</h3>
      <p>{t['features.catalogBody']}</p>
    </article>
    <article class="feature">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4A2.5 2.5 0 0 1 4 13.5z"/><path d="M8.5 10h7"/></svg>
      <h3>{t['features.aiTitle']}</h3>
      <p>{t['features.aiBody']}</p>
    </article>
    <article class="feature">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="3"/><rect x="8.5" y="6" width="7" height="5" rx="1.2" class="fill-soft"/><path d="M10.5 18.5h3"/></svg>
      <h3>{t['features.widgetTitle']}</h3>
      <p>{t['features.widgetBody']}</p>
    </article>
    <article class="feature">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7.5 10.5 12 15l4.5-4.5M4.5 19.5h15"/></svg>
      <h3>{t['features.importTitle']}</h3>
      <p><Fragment set:html={t['features.importBody']} /></p>
    </article>
    <article class="feature">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg>
      <h3>{t['features.themeTitle']}</h3>
      <p>{t['features.themeBody']}</p>
    </article>
    <article class="feature">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8.5" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9.5" r="2.3"/><path d="M15.8 14.3a4.2 4.2 0 0 1 4.7 4.2"/></svg>
      <h3>{t['features.familyTitle']}</h3>
      <p>{t['features.familyBody']}</p>
    </article>
  </div>
  <p class="section-links">
    <a class="arrow" href={`${lang.path}free-subscription-tracker/`}>{t['footer.free']}</a>
    <span class="dot">·</span>
    <a class="arrow" href={`${lang.path}firefly-iii-subscription-tracker/`}>{t['footer.firefly']}</a>
    <span class="dot">·</span>
    <a class="arrow" href={`${lang.path}wallos-alternative/`}>{t['footer.wallos']}</a>
    <span class="dot">·</span>
    <a class="arrow" href={`${lang.path}subscription-tracker-vs-spreadsheet/`}>{t['footer.spreadsheet']}</a>
  </p>
</section>
